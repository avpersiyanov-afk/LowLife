+def _ensure_work_plane(doc, view):
+    """Ensure the active view has a work plane for work-plane placement."""
+    if getattr(view, "SketchPlane", None) is not None:
+        return
+    try:
+        normal = view.ViewDirection
+        origin = view.Origin
+    except Exception:
+        normal = DB.XYZ.BasisZ
+        origin = DB.XYZ.Zero
+    transaction = DB.Transaction(doc, tr(
+        u"╨Ч╨░╨┤╨░╤В╤М ╤А╨░╨▒╨╛╤З╤Г╤О ╨┐╨╗╨╛╤Б╨║╨╛╤Б╤В╤М ╨╗╨╕╨╜╨╕╨╣ ╤В╤А╨░╤Б╤Б╤Л", u"Set route-line work plane"
+    ))
+    transaction.Start()
+    try:
+        view.SketchPlane = DB.SketchPlane.Create(
+            doc, DB.Plane.CreateByNormalAndOrigin(normal, origin)
+        )
+        transaction.Commit()
+    except Exception:
+        if transaction.GetStatus() == DB.TransactionStatus.Started:
+            transaction.RollBack()
+        raise
