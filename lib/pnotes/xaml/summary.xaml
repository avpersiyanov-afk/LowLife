<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Сводка по проекту" Width="1320" Height="660" MinWidth="780" MinHeight="400"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="False"
        FontFamily="Segoe UI" FontSize="13" Background="White">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Padding" Value="6,3"/>
        </Style>
    </Window.Resources>
    <DockPanel Margin="14">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock x:Name="txtProject" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"/>
            <TextBlock x:Name="txtNotice" Foreground="#B04A00" TextWrapping="Wrap" Margin="0,4,0,0" Visibility="Collapsed"/>
            <WrapPanel Margin="0,10,0,8">
                <ComboBox x:Name="cmbStatus" Width="120"/>
                <ComboBox x:Name="cmbType" Width="150"/>
                <ComboBox x:Name="cmbSection" Width="130"/>
                <ComboBox x:Name="cmbAuthor" Width="150"/>
                <TextBlock Text="Поиск:" VerticalAlignment="Center" Margin="6,0,6,0" Foreground="#555555"/>
                <TextBox x:Name="txtSearch" Width="220" Padding="4,3" Margin="0,0,12,0"/>
                <CheckBox x:Name="chkMine" Content="Только мои" VerticalAlignment="Center"/>
            </WrapPanel>
        </StackPanel>

        <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0" LastChildFill="False">
            <Button x:Name="btnDone" DockPanel.Dock="Left" Content="✓ Выполнено" FontWeight="SemiBold"/>
            <Button x:Name="btnWork" DockPanel.Dock="Left" Content="В работе"/>
            <Button x:Name="btnCancelNote" DockPanel.Dock="Left" Content="Неактуально"/>
            <Button x:Name="btnReopen" DockPanel.Dock="Left" Content="Открыть снова"/>
            <Button x:Name="btnEdit" DockPanel.Dock="Left" Content="✎ Изменить" Margin="12,0,6,0"/>
            <Button x:Name="btnAnswer" DockPanel.Dock="Left" Content="Ответ / решение"/>
            <Button x:Name="btnShow" DockPanel.Dock="Left" Content="Показать элементы" Margin="12,0,6,0"/>
            <Button x:Name="btnClose" DockPanel.Dock="Right" Content="Закрыть" Margin="0"/>
            <Button x:Name="btnRefresh" DockPanel.Dock="Right" Content="Обновить"/>
            <Button x:Name="btnSheet" DockPanel.Dock="Right" Content="Открыть таблицу"/>
        </DockPanel>
        <TextBlock x:Name="txtInfo" DockPanel.Dock="Bottom" Foreground="#666666" Margin="0,6,0,0"/>

        <DataGrid x:Name="dg" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Extended"
                  HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E6E6E6"
                  CanUserAddRows="False" Background="White" BorderBrush="#DDDDDD" RowHeaderWidth="0">
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding overdue}" Value="1">
                            <Setter Property="Background" Value="#FDE7E9"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding closed}" Value="1">
                            <Setter Property="Foreground" Value="#9E9E9E"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding status}" Value="Не отправлено">
                            <Setter Property="FontStyle" Value="Italic"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Срок" Binding="{Binding due}" Width="85"/>
                <DataGridTextColumn Header="Тип" Binding="{Binding type}" Width="105"/>
                <DataGridTextColumn Header="Раздел" Binding="{Binding section}" Width="70"/>
                <DataGridTextColumn Header="Текст" Binding="{Binding text}" Width="*" MinWidth="220">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextWrapping" Value="Wrap"/>
                            <Setter Property="Margin" Value="2,3"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Решение" Binding="{Binding answer}" Width="*" MinWidth="180">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextWrapping" Value="Wrap"/>
                            <Setter Property="Margin" Value="2,3"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding need_answer}" Value="1">
                                    <Setter Property="Background" Value="#FFE0B2"/>
                                    <Setter Property="FontStyle" Value="Italic"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Кому" Binding="{Binding assignee}" Width="100"/>
                <DataGridTextColumn Header="Автор" Binding="{Binding author}" Width="100"/>
                <DataGridTextColumn Header="Создано" Binding="{Binding created}" Width="112"/>
                <DataGridTextColumn Header="Статус" Binding="{Binding status}" Width="100"/>
                <DataGridTextColumn Header="Вид" Binding="{Binding view}" Width="130"/>
                <DataGridTextColumn Header="Модель" Binding="{Binding model}" Width="120"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
