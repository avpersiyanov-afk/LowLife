<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ответ / решение" Width="540" SizeToContent="Height"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize" ShowInTaskbar="False"
        FontFamily="Segoe UI" FontSize="13" Background="White">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="16,6"/>
            <Setter Property="MinWidth" Value="100"/>
        </Style>
    </Window.Resources>
    <StackPanel Margin="18">
        <Border Background="#F2F5F9" CornerRadius="4" Padding="10,8">
            <StackPanel>
                <TextBlock x:Name="txtHead" Foreground="#666666" FontSize="12"/>
                <TextBlock x:Name="txtQuestion" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,4,0,0"
                           MaxHeight="160"/>
            </StackPanel>
        </Border>

        <TextBlock Text="Ответ / решение" Foreground="#555555" Margin="0,12,0,4"/>
        <TextBox x:Name="txtAnswer" Height="130" AcceptsReturn="True" TextWrapping="Wrap" Padding="4"
                 VerticalScrollBarVisibility="Auto"/>

        <CheckBox x:Name="chkClose" Content="Отметить «Выполнено»" Margin="0,12,0,0"/>
        <TextBlock x:Name="txtHint" Foreground="#B04A00" TextWrapping="Wrap" Margin="0,10,0,0"/>

        <DockPanel Margin="0,14,0,0" LastChildFill="False">
            <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" Foreground="#888888" FontSize="11"
                       Text="Ctrl+Enter — сохранить, Esc — отмена"/>
            <Button x:Name="btnCancel" DockPanel.Dock="Right" Content="Отмена" Margin="8,0,0,0"/>
            <Button x:Name="btnSave" DockPanel.Dock="Right" Content="Сохранить" FontWeight="SemiBold"/>
        </DockPanel>
    </StackPanel>
</Window>
