<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Новая заметка по проекту" Width="540" SizeToContent="Height"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize" ShowInTaskbar="False"
        FontFamily="Segoe UI" FontSize="13" Background="White">
    <Window.Resources>
        <Style x:Key="Caption" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#555555"/>
            <Setter Property="Margin" Value="0,12,0,4"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="16,6"/>
            <Setter Property="MinWidth" Value="100"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="6,4"/>
        </Style>
    </Window.Resources>
    <StackPanel Margin="18">
        <Border Background="#F2F5F9" CornerRadius="4" Padding="10,8">
            <StackPanel>
                <TextBlock x:Name="txtProject" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="txtContext" Foreground="#666666" FontSize="12" Margin="0,3,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <TextBlock Style="{StaticResource Caption}" Text="Тип"/>
        <ComboBox x:Name="cmbType"/>

        <TextBlock Style="{StaticResource Caption}" Text="Раздел"/>
        <ComboBox x:Name="cmbSection"/>

        <TextBlock Style="{StaticResource Caption}" Text="Текст"/>
        <TextBox x:Name="txtText" Height="130" AcceptsReturn="True" TextWrapping="Wrap" Padding="4"
                 VerticalScrollBarVisibility="Auto"/>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Style="{StaticResource Caption}" Text="Срок (необязательно)"/>
                <DatePicker x:Name="dpDue"/>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Style="{StaticResource Caption}" Text="Кому (необязательно)"/>
                <ComboBox x:Name="cmbAssignee" IsEditable="True"/>
            </StackPanel>
        </Grid>

        <CheckBox x:Name="chkElements" Margin="0,14,0,0"/>
        <TextBlock x:Name="txtStatus" Foreground="#B04A00" TextWrapping="Wrap" Margin="0,10,0,0"/>

        <DockPanel Margin="0,14,0,0" LastChildFill="False">
            <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" Foreground="#888888" FontSize="11"
                       Text="Ctrl+Enter — сохранить, Esc — отмена"/>
            <Button x:Name="btnCancel" DockPanel.Dock="Right" Content="Отмена" Margin="8,0,0,0"/>
            <Button x:Name="btnSave" DockPanel.Dock="Right" Content="Сохранить" FontWeight="SemiBold"/>
        </DockPanel>
    </StackPanel>
</Window>
