<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="LowLife Music"
    Width="250"
    Height="160"
    WindowStartupLocation="CenterScreen">

    <StackPanel>

        <TextBlock Text="🎵 LowLife Music"
                   HorizontalAlignment="Center"
                   FontSize="18"
                   Margin="10"/>


        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Center">

            <Button Name="PrevButton"
                    Content="⏮"
                    Width="50"
                    Height="35"
                    Margin="5"/>

            <Button Name="PlayButton"
                    Content="▶️"
                    Width="50"
                    Height="35"
                    Margin="5"/>

            <Button Name="NextButton"
                    Content="⏭"
                    Width="50"
                    Height="35"
                    Margin="5"/>

        </StackPanel>


        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Center">

            <Button Name="VolDownButton"
                    Content="🔉"
                    Width="50"
                    Height="30"
                    Margin="5"/>

            <Button Name="VolUpButton"
                    Content="🔊"
                    Width="50"
                    Height="30"
                    Margin="5"/>

        </StackPanel>

    </StackPanel>

</Window>
